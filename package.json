{
  "name": "azula",
  "version": "1.0.0",
  "description": "Next generation music bot",
  "author": "Timic3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#/*": "./dist/*.js",
    "#infrastructure/*": "./dist/infrastructure/*.js",
    "#services/*": "./dist/services/*.js",
    "#utils/*": "./dist/utils/*.js"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "start": "node --env-file .env --preserve-symlinks --enable-source-maps dist/index.js",
    "lint": "eslint .",
    "dev": "tsup --watch --onSuccess \"npm start\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timic3/azula.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Timic3/azula/issues"
  },
  "homepage": "https://github.com/Timic3/azula#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-api": "^8.3.1",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/type": "^2.6.0",
    "@sapphire/utilities": "^3.18.2",
    "bgutils-js": "^4.0.3",
    "discord.js": "^14.27.0",
    "googlevideo": "^4.1.1",
    "jsdom": "^30.0.1",
    "sodium": "^3.0.2",
    "tsup": "^8.5.0",
    "undici": "^8.10.0",
    "youtubei.js": "github:LuanRT/YouTube.js#0bdd5f198305c40f09f39ea2bf12f686dce02b55"
  },
  "devDependencies": {
    "@sapphire/ts-config": "^5.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^8.57.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.9.2"
  },
  "volta": {
    "node": "26.7.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "@sapphire/type@2.6.0": true,
    "esbuild@0.25.9": true,
    "ffmpeg-static@5.3.0": true,
    "sodium@3.0.2": true
  }
}
